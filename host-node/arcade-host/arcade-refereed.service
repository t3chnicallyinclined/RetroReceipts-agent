[Unit]
Description=Retro Receipts match referee (watches the assigned money match, counts the set, reports the result)
After=arcade-hostd.service
# The referee is a COMPONENT of hosting, not a service in its own right. Without these it outlives a
# dead arcade-hostd (WantedBy=default.target + Restart=always), and read_assignment() has no
# freshness gate — so a dead daemon freezes the last assigned_resp.json on disk and the referee keeps
# counting a stale wager against whatever match happens to be on screen. That is a money path.
# Requires = start/stop with the daemon; PartOf = a stop/restart of the daemon propagates here.
Requires=arcade-hostd.service
PartOf=arcade-hostd.service

[Service]
Type=simple
# ⚖ ARMING IS DATA, NEVER CODE (money-expert N2): REFEREE_SEAT_P1 + REFEREE_REPORT live ONLY in
# referee.env — a file no bundle, materializer, or ensure-units pass ever writes. Without this, every
# agent update rewrote the unit and silently DISARMED the referee (sets fought + counted, "WOULD
# report" logged, nothing settled, 30-min refunds — conservation clean, so no audit catches it). The
# mirror risk is worse: arming baked into the bundled unit would arm the whole fleet in one release.
# `-` prefix: absent file = observe mode, the safe default.
EnvironmentFile=-%h/.local/share/retro-receipts/arcade-host/referee.env
ExecStart=/usr/bin/python3 %h/.local/share/retro-receipts/arcade-host/referee.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
