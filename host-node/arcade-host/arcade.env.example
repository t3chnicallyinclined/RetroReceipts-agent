# arcade-host daemon environment  --  copy to  arcade.env  and fill in.
# arcade.env is gitignored and holds the ONLY secret (the shared key).
# The SAME ARCADE_KEY value must exist in /etc/skinsync.env on the nobd VPS.

# REQUIRED: shared secret checked on every HTTP route (X-Arcade-Key header).
# Generate once with:  openssl rand -hex 32
ARCADE_KEY=

# HTTP bind + port (contract: 0.0.0.0:7301, firewall restricts who can reach it)
ARCADE_BIND=0.0.0.0
ARCADE_PORT=7301

# Steam appid (MvC Fighting Collection)
ARCADE_APPID=2634890

# Path to the proven libsteam_api.so (from ~/lobbymaker on the OVH box)
ARCADE_STEAM_SO=/home/ubuntu/lobbymaker/libsteam_api.so

# Seconds to wait for LobbyCreated_t before giving up on a create
ARCADE_CREATE_TIMEOUT=15

# Log level: DEBUG|INFO|WARNING
ARCADE_LOG=INFO
